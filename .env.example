# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Configuration (optional in preview: app automatically uses local preview fallback when omitted)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Permanent Platform Administrators (comma-separated lowercase Google OAuth emails)
ADMIN_EMAILS="admin@forgesec.academy"

# Preview Mode Controls (disabled automatically in production unless explicitly enabled)
ENABLE_LOCAL_PREVIEW_AUTH="false"
PREVIEW_AUTH_SECRET=""
